{
  "name": "take-your-heart",
  "productName": "Take Your Heart",
  "version": "0.5.0",
  "private": true,
  "description": "Lokalny kreator bohatera i Persony do Persona RPG",
  "author": "Persona RPG",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/copy-manuals.cjs && tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "test": "tsx --test tests/model.test.ts tests/library.test.ts tests/session.test.ts",
    "test:desktop": "node tests/desktop.cjs && node tests/session.cjs",
    "package:win": "npm run build && electron-builder --win dir",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:linux": "npm run build && electron-builder --linux dir --x64 && node scripts/package-linux.cjs",
    "package:linux:appimage": "npm run build && electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "pl.personarpg.takeyourheart",
    "productName": "Take Your Heart",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.games"
    },
    "linux": {
      "category": "Game",
      "icon": "assets/icon.png",
      "executableName": "take-your-heart"
    },
    "extraResources": [
      {
        "from": "assets/manuals",
        "to": "podreczniki",
        "filter": [
          "*.docx"
        ]
      }
    ]
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
